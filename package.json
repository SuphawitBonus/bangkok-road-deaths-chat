{
  "name": "bangkok-road-deaths-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ถามข้อมูลผู้เสียชีวิตจากอุบัติเหตุทางถนนในกรุงเทพฯ เป็นภาษาไทยหรืออังกฤษ แล้วให้ AI เขียน SQL ไปค้นคำตอบ",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:load": "tsx src/scripts/load.ts",
    "db:setup": "npm run db:migrate && npm run db:load",
    "db:check": "tsx src/scripts/check-db-security.ts",
    "docs:schema": "tsx src/scripts/dump-schema-doc.ts",
    "evals:verify": "tsx src/scripts/verify-evals.ts",
    "evals:crosscheck": "python evals/crosscheck.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "libpg-query": "^17.2.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2",
    "vitest": "^5.1.0"
  }
}
