# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า — .env ถูก gitignore ไว้ ห้าม commit
#
#   cp .env.example .env
#
# สองบทบาทแยกกันโดยตั้งใจ ดูเหตุผลใน docs/security.md
#   - ADMIN  : เจ้าของ schema ใช้ตอน migrate / load ข้อมูล / รัน eval
#   - AI     : อ่านได้อย่างเดียว เป็น role ที่ SQL จาก AI จะถูกรันด้วย

# ───────────── Postgres ในเครื่อง (docker compose) ─────────────
POSTGRES_HOST=localhost
# 5432-5434 มักถูกโปรเจกต์อื่นใช้อยู่ เลยตั้ง default ไว้ที่ 5435
POSTGRES_PORT=5435
POSTGRES_DB=roaddeaths

# ตั้งรหัสผ่านเองก่อนรัน docker compose up (สุ่มมาสักชุด)
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=

# รหัสผ่านของ role ที่ใช้รัน SQL จาก AI — ต้องคนละตัวกับด้านบน
AI_DB_USER=ai_reader
AI_DB_PASSWORD=

# ───────────── ตอน deploy (Neon) ─────────────
# ใส่เป็น environment variable บนแพลตฟอร์ม ไม่ต้องเขียนลงไฟล์
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# AI_DATABASE_URL=postgresql://ai_reader:password@host/db?sslmode=require

# ───────────── ขอบเขตการรัน SQL ─────────────
# เพดานแถวที่ยอมให้คืน ถ้า SQL ไม่มี LIMIT ตัวตรวจจะใส่ให้เอง
SQL_MAX_ROWS=1000
# เวลาสูงสุดต่อหนึ่งคำสั่ง (มิลลิวินาที) ต้องไม่เกิน 5000 ตามที่ตั้งไว้ที่ role
SQL_TIMEOUT_MS=5000
