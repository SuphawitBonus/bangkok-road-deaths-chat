# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่า — .env ถูก gitignore ไว้ ห้าม commit
#
#   cp .env.example .env
#
# สองบทบาทแยกกันโดยตั้งใจ ดูเหตุผลใน docs/security.md
#   - ADMIN  : เจ้าของ schema ใช้ตอน migrate / load ข้อมูล / รัน eval
#   - AI     : อ่านได้อย่างเดียว เป็น role ที่ SQL จาก AI จะถูกรันด้วย

# ───────────── Postgres ในเครื่อง (docker compose) ─────────────
POSTGRES_HOST=localhost
# 5432-5434 มักถูกโปรเจกต์อื่นใช้อยู่ เลยตั้ง default ไว้ที่ 5435
POSTGRES_PORT=5435
POSTGRES_DB=roaddeaths

# ตั้งรหัสผ่านเองก่อนรัน docker compose up (สุ่มมาสักชุด)
POSTGRES_USER=app_admin
POSTGRES_PASSWORD=

# รหัสผ่านของ role ที่ใช้รัน SQL จาก AI — ต้องคนละตัวกับด้านบน
AI_DB_USER=ai_reader
AI_DB_PASSWORD=

# ───────────── ตอน deploy (Neon) ─────────────
# ใส่เป็น environment variable บนแพลตฟอร์ม ไม่ต้องเขียนลงไฟล์
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# AI_DATABASE_URL=postgresql://ai_reader:password@host/db?sslmode=require

# ───────────── ขอบเขตการรัน SQL ─────────────
# เพดานแถวที่ยอมให้คืน ถ้า SQL ไม่มี LIMIT ตัวตรวจจะใส่ให้เอง
SQL_MAX_ROWS=1000
# เวลาสูงสุดต่อหนึ่งคำสั่ง (มิลลิวินาที) ต้องไม่เกิน 5000 ตามที่ตั้งไว้ที่ role
SQL_TIMEOUT_MS=5000

# ───────────── Claude API (สัปดาห์ที่ 2) ─────────────
# ใส่ key ที่ .env เท่านั้น ห้ามใส่ในไฟล์อื่นหรือในโค้ด
ANTHROPIC_API_KEY=
# model ที่ ask() ใช้ ค่าเริ่มต้น claude-haiku-5-5 (เปลี่ยนต่อครั้งได้ด้วย --model ของ evals:run)
ASK_MODEL=claude-haiku-5-5
# ระดับความพยายามของโมเดล low | medium | high
ASK_EFFORT=medium
# จำนวนรอบ tool call สูงสุดต่อคำถาม (นับทุกรอบ รวมรอบที่ SQL ถูกปฏิเสธ)
ASK_MAX_TOOL_ROUNDS=4

# ───────────── Web reader (หน้าเว็บ) ─────────────
# role web_reader อ่านได้เฉพาะตารางสรุป app.h3_deaths_monthly (ไม่มีข้อมูลรายคน) ดู docs/privacy.md
# ตั้งรหัสผ่านแล้วรัน `npm run db:migrate` เพื่อสร้าง role และให้สิทธิ์ (ถ้าไม่ตั้ง migrate จะข้ามขั้นนี้)
# เว็บอ่านจากไฟล์นี้เฉพาะ 6 ตัวแปร: WEB_DB_USER, WEB_DB_PASSWORD, WEB_DATABASE_URL, POSTGRES_HOST/PORT/DB
# (รหัสผ่านของ role อื่นในไฟล์นี้ เว็บไม่อ่านและไม่เก็บไว้ในหน่วยความจำ)
# ไม่มีรหัสผ่านนี้ เว็บจะไม่เริ่มทำงาน — ไม่มีการสลับไปใช้ role อื่น
WEB_DB_USER=web_reader
WEB_DB_PASSWORD=

# ตอน deploy (Neon): ตั้งบนแพลตฟอร์มแทน WEB_DB_* ชื่อผู้ใช้ใน URL ต้องเป็น web_reader เท่านั้น
# WEB_DATABASE_URL=postgresql://web_reader:password@host/db?sslmode=require
